# การตั้งค่า Aruba Controller
ARUBA_URL=https://192.168.1.5 # ใส่ IP ของ Aruba Controller ของคุณ (อย่าลืม https)
ARUBA_USER=admin              # Username
ARUBA_PASS=password           # Password
PORT=3000

# ตั้งค่าให้ข้ามการตรวจสอบ SSL Certificate ชั่วคราว (จำเป็นถ้าใช้ cert เองใน Lab)
NODE_TLS_REJECT_UNAUTHORIZED=0