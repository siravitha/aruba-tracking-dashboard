# --- การเชื่อมต่อ Aruba Virtual Controller ---
ARUBA_URL=https://192.168.1.253:4343          # ใส่ IP ของ Virtual Controller (ต้องเป็น HTTPS เสมอ)
ARUBA_USER=admin                         # User ที่มีสิทธิ์เข้าถึง API
ARUBA_PASS=P@ssw0rd                      # Password ของ user นั้น

# --- ตั้งค่าระบบ ---
PORT=8080                                # พอร์ตของ Dashboard
NODE_TLS_REJECT_UNAUTHORIZED=0           # **สำคัญ:** อนุญาตให้ Node เชื่อมต่อ Aruba แบบ Self-Signed Cert ได้